{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notes-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notes-db",
      "database_id": "75c99354-84d9-461d-8dad-347c39c07aa6"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}